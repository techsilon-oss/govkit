{
  "name": "govkit",
  "private": true,
  "description": "govkit's own guardrails, run in place from the templates it ships. The version lives in .claude-plugin/plugin.json, not here.",
  "license": "MIT",
  "scripts": {
    "prepare": "git config core.hooksPath skills/govkit-init/templates/githooks || exit 0",
    "test": "node --test \"tests/*.test.mjs\"",
    "docs:sync-check": "node skills/govkit-init/templates/scripts/docs-sync-check.mjs",
    "docs:sync-check:ci": "node skills/govkit-init/templates/scripts/docs-sync-check.mjs --ci",
    "sdlc-docs:audit": "node skills/govkit-init/templates/scripts/sdlc-docs.mjs audit --warn",
    "sdlc-docs:gate": "node skills/govkit-init/templates/scripts/sdlc-docs.mjs audit --gate",
    "sdlc-docs:report": "node skills/govkit-init/templates/scripts/sdlc-docs.mjs report",
    "govkit:doctor": "node skills/govkit-init/templates/scripts/govkit-doctor.mjs",
    "govkit:config": "node skills/govkit-init/templates/scripts/govkit-doctor.mjs config",
    "release:check": "node tools/check-release.mjs"
  }
}
